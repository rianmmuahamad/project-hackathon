# Copy to .env and fill in. Never commit .env.
SECTORS_API_KEY=

# Optional overrides
# SECTORS_API_BASE=https://api.sectors.app
# THESISRADAR_HOME=.thesisradar
# THESISRADAR_ENGINE=auto        # auto | hermes | direct
# THESISRADAR_MODEL=             # model id for the direct engine
# THESISRADAR_CHECK_BUDGET=25    # Sectors credits allowed per thesis check

# Jev (TypeSafe System One) — the decision layer.
# Decides each claim's state from measured evidence, in one sub-second call, and
# acts as the guardrail on the prose the agent writes. Without a key the product
# falls back to the agent deciding alone.
# THESISRADAR_JEV_BASE=https://mot.coddx.store/v1
# THESISRADAR_JEV_KEY=
# THESISRADAR_JEV_MODEL=jev-1.13-free
# THESISRADAR_JEV_TIMEOUT=30