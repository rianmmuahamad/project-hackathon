# Copy to .env and fill in. Never commit .env.
SECTORS_API_KEY=

# Optional overrides
# SECTORS_API_BASE=https://api.sectors.app
# THESISRADAR_HOME=.thesisradar
# THESISRADAR_ENGINE=auto        # auto | hermes | direct
# THESISRADAR_MODEL=             # model id for the direct engine
# THESISRADAR_CHECK_BUDGET=25    # Sectors credits allowed per thesis check

# Jev (TypeSafe System One) — the decision layer.
# Decides each claim's state from measured evidence, in one sub-second call, and
# acts as the guardrail on the prose the agent writes. Without a key the product
# falls back to the agent deciding alone.
# THESISRADAR_JEV_BASE=https://mot.coddx.store/v1
# THESISRADAR_JEV_KEY=
# THESISRADAR_JEV_MODEL=jev-1.13-free
# THESISRADAR_JEV_TIMEOUT=30

# Scheduled checks — the sweep runs unattended and reports by email.
# THESISRADAR_SCHEDULE_AT=08:00              # HH:MM, local to the timezone below
# THESISRADAR_SCHEDULE_DAYS=mon,tue,wed,thu,fri   # empty = every day

# Email digest — scheduled checks report here. Without a host and a recipient
# the checks still run and the notifications still land in the dashboard; only
# the email is skipped.
# THESISRADAR_SMTP_HOST=                     # e.g. smtp.gmail.com
# THESISRADAR_SMTP_PORT=587                  # 587 for STARTTLS, 465 for implicit TLS
# THESISRADAR_SMTP_USER=                     # omit for an unauthenticated relay
# THESISRADAR_SMTP_PASSWORD=
# THESISRADAR_SMTP_FROM=                     # defaults to SMTP_USER
# THESISRADAR_SMTP_TO=                       # comma-separated recipients
# THESISRADAR_SMTP_TLS=1                     # 0 uses TLS on connect (port 465)